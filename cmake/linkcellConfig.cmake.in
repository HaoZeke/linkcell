@PACKAGE_INIT@

set_and_check(LINKCELL_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")

if(WIN32)
  set_and_check(LINKCELL_LIBRARY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@/@LINKCELL_SHARED_NAME@")
  set_and_check(LINKCELL_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@LINKCELL_IMPLIB_NAME@")
else()
  set_and_check(LINKCELL_LIBRARY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@LINKCELL_SHARED_NAME@")
endif()

if(NOT TARGET linkcell::linkcell)
  add_library(linkcell::linkcell SHARED IMPORTED)
  set_target_properties(linkcell::linkcell PROPERTIES
    IMPORTED_LOCATION "${LINKCELL_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${LINKCELL_INCLUDE_DIR}"
    INTERFACE_COMPILE_FEATURES cxx_std_17)
  if(WIN32)
    set_target_properties(linkcell::linkcell PROPERTIES
      IMPORTED_IMPLIB "${LINKCELL_IMPLIB}")
  endif()
endif()

check_required_components(linkcell)
